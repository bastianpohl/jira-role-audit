# Base URL of your Jira Cloud site (no trailing slash).
# Used to resolve the cloudId and shown in the report header.
JIRA_BASE_URL=https://your-org.atlassian.net

# OAuth 2.0 credential of the Atlassian *service account*.
# Create it at admin.atlassian.com:
#   Directory > Service accounts > (your account) > Create OAuth 2.0 credential
#
# Grant these 12 granular Jira scopes (see README for why granular over classic):
#   read:project:jira            read:project-role:jira
#   read:project-category:jira   read:project.property:jira
#   read:project-version:jira    read:project.component:jira
#   read:issue-type:jira         read:issue-type-hierarchy:jira
#   read:user:jira               read:group:jira
#   read:avatar:jira             read:application-role:jira
#
# Scopes alone are not enough — the service account also needs Jira product access
# and the *Administer Jira* global permission, or the report is silently incomplete.
JIRA_CLIENT_ID=your-client-id
JIRA_CLIENT_SECRET=your-client-secret

# Optional: skip the cloudId lookup by setting it explicitly.
# When unset it is resolved automatically by matching JIRA_BASE_URL against
# https://api.atlassian.com/oauth/token/accessible-resources
#JIRA_CLOUD_ID=
