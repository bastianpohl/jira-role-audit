# Base URL of your Jira Cloud site (no trailing slash).
# Used to resolve the cloudId and shown in the report header.
JIRA_BASE_URL=https://your-org.atlassian.net

# OAuth 2.0 credential of the Atlassian *service account*.
# Create it at admin.atlassian.com:
#   Directory > Service accounts > (your account) > Create OAuth 2.0 credential
# Grant it at least these Jira scopes: read:jira-work, read:jira-user
JIRA_CLIENT_ID=your-client-id
JIRA_CLIENT_SECRET=your-client-secret

# Optional: skip the cloudId lookup by setting it explicitly.
# When unset it is resolved automatically by matching JIRA_BASE_URL against
# https://api.atlassian.com/oauth/token/accessible-resources
#JIRA_CLOUD_ID=
