# Base URL of your Jira Cloud site (no trailing slash).
# Shown in the report header, and used to resolve the cloudId in OAuth mode.
JIRA_BASE_URL=https://your-org.atlassian.net

# Pick ONE of the two credentials below. Configuring both is an error unless
# JIRA_AUTH says which to use — the report's contents depend on the acting
# identity's permissions, so this is never guessed.
#JIRA_AUTH=basic   # or: oauth

# ---------------------------------------------------------------------------
# Option A — your own Atlassian account (API token, Basic auth)
# ---------------------------------------------------------------------------
# Simplest path, and complete if your account is a Jira admin. Create the token
# at https://id.atlassian.com/manage-profile/security/api-tokens
# The token carries your *full* user permissions — it is not scope-limited, so
# treat it as a password and prefer Option B for anything unattended.
#JIRA_EMAIL=you@your-org.example
#JIRA_API_TOKEN=your-api-token

# ---------------------------------------------------------------------------
# Option B — Atlassian service account (OAuth 2.0 client credentials)
# ---------------------------------------------------------------------------
# Create it at admin.atlassian.com:
#   Directory > Service accounts > (your account) > Create OAuth 2.0 credential
#
# Grant these 12 granular Jira scopes (see README for why granular over classic):
#   read:project:jira            read:project-role:jira
#   read:project-category:jira   read:project.property:jira
#   read:project-version:jira    read:project.component:jira
#   read:issue-type:jira         read:issue-type-hierarchy:jira
#   read:user:jira               read:group:jira
#   read:avatar:jira             read:application-role:jira
#
# Scopes alone are not enough — the service account also needs Jira product access
# and the *Administer Jira* global permission, or the report is silently incomplete.
JIRA_CLIENT_ID=your-client-id
JIRA_CLIENT_SECRET=your-client-secret

# Optional, OAuth only: skip the cloudId lookup by setting it explicitly.
# When unset it is resolved automatically by matching JIRA_BASE_URL against
# https://api.atlassian.com/oauth/token/accessible-resources
#JIRA_CLOUD_ID=
